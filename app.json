{
  "expo": {
    "name": "ChowLocal Courier",
    "slug": "chowlocal-courier-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chowlocal.courier",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ChowLocal Courier needs your location to track deliveries and show you nearby orders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ChowLocal Courier uses your location to track deliveries even when the app is in the background."
      }
    },
    "android": {
      "package": "com.chowlocal.courier",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ChowLocal Courier needs your location to track deliveries."
        }
      ]
    ]
  }
}
